{
  "name": "statusquo",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sentry/browser": "^11.10.0",
    "@sentry/vite-plugin": "^11.10.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Combine any number of third-party status pages into one dashboard and RSS feed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/statusquo.git"
  },
  "homepage": "https://statusquo.peng.ly",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
