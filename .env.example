# Pin one board as the homepage. Catalogue slugs or full status page URLs, comma separated.
# This is how most self-hosters run it: one fixed set, no builder, no database.
STATUSQUO_PAGES=

# What to call the instance, and the line under the name on the front page.
STATUSQUO_TITLE=statusquo
STATUSQUO_TAGLINE=

# Set to false to hide the builder, so visitors can only see the pinned board.
STATUSQUO_PUBLIC=true

# How long a board is held at the edge, and how often an open page asks for a fresh one.
STATUSQUO_REFRESH_SECONDS=60

# Where service icons come from. {domain} is replaced with the service's own domain.
STATUSQUO_ICONS=https://icons.duckduckgo.com/ip3/{domain}.ico
